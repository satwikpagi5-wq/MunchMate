rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // -------------------------------------------------------------------------
    // HELPERS
    // -------------------------------------------------------------------------
    
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isEmailVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (request.auth.token.email == 'saatwikpagi5@gmail.com' && request.auth.token.email_verified == true)
      );
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // -------------------------------------------------------------------------
    // ENTITY VALIDATION HELPERS
    // -------------------------------------------------------------------------

    function isValidMenuItem(data) {
      return data.keys().hasAll(['name', 'price', 'category', 'description', 'image']) &&
             data.keys().size() >= 5 &&
             data.name is string && data.name.size() <= 100 &&
             data.price is number && data.price > 0 &&
             data.category is string && data.category.size() <= 50 &&
             data.description is string && data.description.size() <= 500 &&
             data.image is string && data.image.size() <= 1000;
    }

    function isValidOrder(data) {
      return data.keys().hasAll(['userId', 'items', 'total', 'status', 'createdAt', 'qrCode']) &&
             data.userId == request.auth.uid &&
             data.items is list && data.items.size() > 0 && data.items.size() <= 50 &&
             data.total is number && data.total >= 0 &&
             data.status in ['pending', 'preparing', 'ready', 'delivered'] &&
             data.qrCode is string && data.qrCode.size() <= 100;
    }

    function isValidUserProfile(data) {
      return data.keys().hasAll(['uid', 'walletBalance', 'points', 'streak']) &&
             data.uid == request.auth.uid &&
             data.walletBalance is number && data.walletBalance >= 0 &&
             data.points is number && data.points >= 0 &&
             data.streak is number && data.streak >= 0;
    }

    function isValidBooking(data) {
      return data.keys().hasAll(['userId', 'sectionId', 'time', 'guests', 'createdAt']) &&
             data.userId == request.auth.uid &&
             data.sectionId is string && data.sectionId.size() <= 50 &&
             data.time is string && data.time.size() <= 50 &&
             data.guests is number && data.guests > 0 && data.guests <= 20;
    }

    // -------------------------------------------------------------------------
    // GLOBAL CATCH-ALL
    // -------------------------------------------------------------------------
    match /{document=**} {
      allow read, write: if false;
    }

    // -------------------------------------------------------------------------
    // COLLECTIONS
    // -------------------------------------------------------------------------

    // Menu: Public read (authenticated), Admin write
    match /menu/{itemId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin() && isValidId(itemId) && (request.method == 'delete' || isValidMenuItem(incoming()));
    }

    // Orders: Multi-tiered access
    match /orders/{orderId} {
      allow get: if isSignedIn() && (isOwner(existing().userId) || isAdmin());
      allow list: if isSignedIn() && (existing().userId == request.auth.uid || isAdmin());
      
      allow create: if isSignedIn() && isValidId(orderId) && isEmailVerified() &&
                    isValidOrder(incoming()) && 
                    incoming().createdAt == request.time;
      
      allow update: if isSignedIn() && isValidId(orderId) && (
        isAdmin() || (
          isOwner(existing().userId) && 
          existing().status == 'pending' &&
          incoming().diff(existing()).affectedKeys().hasOnly(['items', 'total', 'pickupTime']) &&
          isValidOrder(incoming())
        ) || (
          // Admin action: update status
          isAdmin() && 
          incoming().diff(existing()).affectedKeys().hasOnly(['status']) &&
          isValidOrder(incoming())
        )
      );
      
      allow delete: if isAdmin();
    }

    // Users: Private read/write for owner, Admin read
    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      
      allow create: if isOwner(userId) && isValidUserProfile(incoming());
      
      allow update: if (isOwner(userId) || isAdmin()) && 
                    isValidUserProfile(incoming()) && (
                      // Users can't change their own isAdmin or high-privilege fields
                      isAdmin() || (
                        incoming().diff(existing()).affectedKeys().hasOnly(['streak', 'points', 'walletBalance']) &&
                        incoming().uid == existing().uid
                      )
                    );
    }

    // Bookings: Owner access
    match /bookings/{bookingId} {
      allow get: if isOwner(existing().userId) || isAdmin();
      allow list: if isSignedIn() && (existing().userId == request.auth.uid || isAdmin());
      
      allow create: if isSignedIn() && isValidId(bookingId) && isEmailVerified() &&
                    isValidBooking(incoming()) && 
                    incoming().createdAt == request.time;
      
      allow delete: if isOwner(existing().userId) || isAdmin();
    }

    // Admins collection: System-only or Admin-only
    match /admins/{userId} {
      allow read: if isSignedIn();
      allow write: if false; // Managed via console
    }
  }
}
